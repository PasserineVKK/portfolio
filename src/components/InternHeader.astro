---
import { portfolio } from '../data/portfolio';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';
const path = Astro.url.pathname;
const nav = [
  { label: 'Overview', href: '/intern/' },
  { label: 'Projects', href: '/intern/projects/' },
  { label: 'Research', href: '/intern/research/' },
  { label: 'Experience', href: '/intern/experience/' },
];
---

<header class="site-header">
  <div class="site-wrap header-inner">
    <a class="brand" href="/" aria-label="Passerine — choose a profile"><Image src={logo} alt="" width={34} height={34} />{portfolio.alias}<span aria-hidden="true">.</span></a>
    <nav class="primary-nav" aria-label="The Intern sections">
      {nav.map(({ label, href }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="header-contact" href={`mailto:${portfolio.email}`}>Contact <span aria-hidden="true">↗</span></a>
  </div>
</header>
