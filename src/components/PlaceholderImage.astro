---
import { Image } from 'astro:assets';
import placeholder from '../assets/placeholder.svg';

interface Props {
  alt: string;
  label: string;
  class?: string;
  eager?: boolean;
}

const { alt, label, class: className = '', eager = false } = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden border border-line bg-placeholder',
    className,
  ]}
>
  <Image
    src={placeholder}
    alt={alt}
    width={1600}
    height={1000}
    loading={eager ? 'eager' : 'lazy'}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <span
    aria-hidden="true"
    class="relative z-10 flex h-full items-center justify-center px-5 text-center font-oswald text-sm tracking-[.12em] text-ink-muted sm:text-lg"
  >
    {label}
  </span>
</div>
