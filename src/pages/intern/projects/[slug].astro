---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import InternPageLayout from '../../../layouts/InternPageLayout.astro';
import { portfolio } from '../../../data/portfolio';

interface Props {
  entry: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<InternPageLayout
  title={`${entry.data.title} | ${portfolio.alias} — ${portfolio.name}`}
  description={`${entry.data.subtitle}. ${entry.data.result}`}
>
  <article class="mx-auto max-w-5xl">
    <nav aria-label="Breadcrumb" class="text-sm">
      <a
        href="/intern/projects/"
        class="text-link-text underline underline-offset-4 hover:text-link-hover"
      >
        Projects
      </a>
      <span aria-hidden="true"> / </span>
      <span>{entry.data.title}</span>
    </nav>
    <p class="mt-10 text-sm font-bold uppercase tracking-[.16em] text-ink-muted">
      {entry.data.role} · {entry.data.status} · {entry.data.year}
    </p>
    <h1 class="mt-4 font-oswald text-5xl font-bold uppercase leading-tight sm:text-7xl">
      {entry.data.titleUrl ? (
        <a
          href={entry.data.titleUrl}
          target="_blank"
          rel="noreferrer"
          class="hover:text-link-hover"
        >
          {entry.data.title}
        </a>
      ) : (
        entry.data.title
      )}
    </h1>
    <p class="mt-3 text-lg leading-8 text-body-text">{entry.data.subtitle}</p>
    <dl class="mt-10 grid gap-5 border-y border-line py-8 md:grid-cols-3">
      {[
        { heading: 'Problem', body: entry.data.problem },
        { heading: 'What I produced', body: entry.data.produced },
        { heading: 'Result', body: entry.data.result },
      ].map(({ heading, body }) => (
        <div>
          <dt class="font-oswald text-xl font-bold uppercase">{heading}</dt>
          <dd class="mt-3 text-sm leading-7 text-body-text">{body}</dd>
        </div>
      ))}
    </dl>
    <div class="cv-detail mt-9 max-w-3xl leading-8 text-body-text">
      <Content />
    </div>
    <div class="mt-9 flex flex-wrap gap-5 border-t border-line pt-6 text-sm font-semibold">
      {entry.data.links.map(({ label, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          class="text-link-text underline underline-offset-4 hover:text-link-hover"
        >
          {label}
        </a>
      ))}
    </div>
    <a
      href="/intern/projects/"
      class="mt-12 inline-block text-link-text underline underline-offset-4 hover:text-link-hover"
    >
      Back to projects
    </a>
  </article>
</InternPageLayout>
