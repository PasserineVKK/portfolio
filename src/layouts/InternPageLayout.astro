---
import Footer from '../components/Footer.astro';
import InternHeader from '../components/InternHeader.astro';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  surface?: boolean;
}

const { title, description, surface = false } = Astro.props;
---

<Layout title={title} description={description}>
  <div id="top"></div>
  <InternHeader />
  <main id="main"
    class:list={[
      'detail-main',
      surface ? 'bg-surface' : 'bg-bg',
    ]}
  >
    <slot />
  </main>
  <Footer />
</Layout>
