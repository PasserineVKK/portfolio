---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { portfolio } from '../../data/portfolio';
import { folio, internProjectIds } from '../../data/internFolio';
import portrait from '../../assets/portrait.png';
import pegaxusScreen from '../../assets/pegaxus-screen.png';
import meetlyScreen from '../../assets/meetly-screen.png';
import '../../styles/intern-folio.css';

const projects = (await getCollection('projects'))
  .filter((entry) => internProjectIds.includes(entry.id))
  .sort((a, b) => a.data.order - b.data.order);
const visuals = ['transport', 'education'];
const marqueeScreens = [
  { kind: 'image' as const, src: pegaxusScreen },
  { kind: 'demo' as const },
  { kind: 'image' as const, src: meetlyScreen },
  { kind: 'image' as const, src: pegaxusScreen },
];
---

<Layout
  title={`The Intern — ${portfolio.name} / ${portfolio.alias}`}
  description={`${portfolio.name} is a Business Analyst Intern in Ho Chi Minh City. Explore selected work in requirements, workflow modeling and prototyping.`}
>
  <div class="folio" id="top">
    <aside class="folio-rail" data-rail aria-label="Folio controls">
      <button class="rail-menu" type="button" data-menu-open aria-label="Open menu" aria-controls="folio-menu" aria-expanded="false"><span></span><span></span></button>
      <div class="rail-middle" aria-hidden="true"><span>FOLIO — {folio.edition}</span><span>{portfolio.name.toUpperCase()}</span></div>
      <span class="rail-copyright" aria-hidden="true">© {new Date().getFullYear()}</span>
    </aside>

    <dialog class="folio-menu" id="folio-menu" aria-label="Folio navigation">
      <div class="menu-top"><span class="micro-label">THE INTERN / INDEX</span><button type="button" data-menu-close aria-label="Close menu">Close <span aria-hidden="true">×</span></button></div>
      <nav aria-label="Folio chapters">
        <a href="#home" data-panel-link><span>01</span> Home <b aria-hidden="true">↗</b></a>
        <a href="#about" data-panel-link><span>02</span> About <b aria-hidden="true">↗</b></a>
        <a href="#works" data-panel-link><span>03</span> Works <b aria-hidden="true">↗</b></a>
        <a href="#contact" data-panel-link><span>04</span> Contact <b aria-hidden="true">↗</b></a>
      </nav>
      <div class="menu-bottom"><span>{folio.availability}</span><a href={portfolio.github} target="_blank" rel="noreferrer">GitHub ↗</a></div>
    </dialog>

    <main id="main" class="folio-stage"><div class="folio-track" data-folio-track>
      <section class="folio-panel panel-hero tone-dark" id="home" data-rail-tone="light" aria-labelledby="folio-title"><div class="panel-pad hero-inner">
        <div class="hero-top"><span class="micro-label">THE INTERN / A PERSONAL FOLIO</span><p>{folio.heroLine}</p></div>
        <h1 id="folio-title"><span>VĂNG KHÁNH KHUYÊN</span><span>PASSERINE</span></h1>
        <div class="hero-bottom"><p class="hero-location"><span>BASED IN {portfolio.location.toUpperCase()} · {folio.timezoneLabel}</span><strong data-local-time>--:--:--</strong></p><p class="hero-availability"><span class="status-dot" aria-hidden="true"></span>{folio.availability}</p><a href="#about" data-panel-link class="hero-scroll">SCROLL <span aria-hidden="true">→</span></a></div>
      </div></section>

      <section class="folio-panel panel-intro tone-light" id="about" data-rail-tone="dark" aria-labelledby="intro-title"><div class="panel-pad intro-inner">
        <div class="chapter-line"><span>CHAPTER I</span><span>01 / 03</span></div>
        <div class="intro-copy"><p class="micro-label">QUICK INTRO</p><h2 id="intro-title">A clearer picture<br />of the work.</h2><p class="intro-body">{folio.introduction}</p></div>
        <div class="portrait-frame"><Image src={portrait} alt="Văng Khánh Khuyên with a teddy bear against a blue studio backdrop" format="webp" loading="lazy" class="portrait-image" /></div>
        <p class="intro-note">“{folio.note}”</p>
        <a class="folio-link intro-link" href="/intern/experience/">More about me <span aria-hidden="true">↗</span></a>
      </div></section>

      <section class="folio-panel panel-transition tone-light" id="work-transition" data-rail-tone="dark" aria-label="The work: transition to selected projects"><div class="transition-inner">
        <span class="transition-word transition-the">THE</span>
        <div class="transition-gallery" aria-hidden="true">
          <div class="marquee-column direction-up"><div class="marquee-stack"><div class="visual-tile tile-transport">P/01</div><div class="visual-tile tile-education">E/02</div><div class="visual-tile tile-transport">P/01</div></div><div class="marquee-stack"><div class="visual-tile tile-transport">P/01</div><div class="visual-tile tile-education">E/02</div><div class="visual-tile tile-transport">P/01</div></div></div>
          <div class="marquee-column direction-down">
            {[0, 1].map(() => <div class="marquee-stack">{marqueeScreens.map((screen) => <div class="visual-tile visual-tile--screen">{screen.kind === 'demo' ? <div class="demo-viewport" data-demo-viewport><iframe src="/demos/educonnect.html?preview=1" title="EduConnect attendance management demo" loading="lazy" sandbox="allow-scripts" tabindex="-1"></iframe></div> : <Image src={screen.src} alt="" format="webp" quality={90} loading="lazy" />}</div>)}</div>)}
          </div>
          <div class="marquee-column direction-up slow"><div class="marquee-stack"><div class="visual-tile tile-education">E/02</div><div class="visual-tile tile-transport">P/01</div><div class="visual-tile tile-education">E/02</div></div><div class="marquee-stack"><div class="visual-tile tile-education">E/02</div><div class="visual-tile tile-transport">P/01</div><div class="visual-tile tile-education">E/02</div></div></div>
        </div>
        <span class="transition-word transition-work">WORK</span><span class="transition-index micro-label">A SELECTION OF QUESTIONS, SYSTEMS & OUTCOMES</span>
      </div></section>

      <section class="folio-panel panel-works tone-stone" id="works" data-rail-tone="dark" aria-labelledby="works-title"><div class="panel-pad works-inner">
        <div class="chapter-line"><span>CHAPTER II</span><span>02 / 03</span></div><div class="works-heading"><p class="micro-label">RELATED WORK</p></div>
        <div class="works-preview"><div class="preview-placeholder" data-project-preview data-visual="education" aria-hidden="true"><span class="preview-diagonal"></span><div class="preview-education-demo demo-viewport" data-demo-viewport><iframe src="/demos/educonnect.html?preview=1" title="EduConnect attendance management demo" loading="lazy" sandbox="allow-scripts" tabindex="-1"></iframe></div><span class="preview-label">EduConnect LMS</span></div><h2 id="works-title">Selected cases.</h2></div>
        <ol class="work-list">{projects.map((project, index) => <li><a href={`/intern/projects/${project.id}/`} data-work-item data-visual={visuals[index]} data-preview-title={project.data.title}><span class="work-number">0{index + 1}</span><span class="work-name">{project.data.title}</span><span class="work-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
        <div class="works-bottom"><p>✳ Case studies in systems thinking and digital experiences.</p><a class="folio-link" href="/intern/projects/">View all work <span aria-hidden="true">↗</span></a></div>
      </div></section>

      <section class="folio-panel panel-services tone-dark" id="approach" data-rail-tone="light" aria-labelledby="services-title"><div class="services-inner">
        <div class="services-intro"><div class="chapter-line"><span>CHAPTER III</span><span>03 / 03</span></div><p class="micro-label">SKILLS</p><h2 id="services-title">From a question<br />to a shared plan.</h2><p>{folio.approach}</p></div>
        <div class="service-grid">{folio.skills.map((skill) => <article class="service-column" tabindex="0">
          <span class="service-number">{skill.number}</span>
          <h3>{skill.title}</h3><ul class="service-items">{skill.items.map((item) => <li>{item}</li>)}</ul>
        </article>)}</div>
      </div></section>

      <section class="folio-panel panel-contact tone-deep" id="contact" data-rail-tone="light" aria-labelledby="contact-title"><div class="panel-pad contact-inner">
        <div class="contact-top"><span class="micro-label">THE INTERN / NEXT CHAPTER</span><nav aria-label="External links">{folio.social.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label} ↗</a>)}</nav></div>
        <h2 id="contact-title">NEXT<br />CHAPTER<span class="contact-period">.</span></h2>
        <div class="contact-bottom"><div><span class="micro-label">CONTACT TO</span><a class="contact-email" href={`mailto:${portfolio.email}`}>{portfolio.email}</a></div><p>WHERE STORIES FIND THEIR FORM</p></div>
      </div></section>
    </div></main>
  </div>
  <script>import '../../scripts/intern-folio.js';</script>
</Layout>
