---
import { footerNavigation } from '../data/navigation';
import { portfolio } from '../data/portfolio';
---

<footer class="site-footer" aria-label="Site footer">
  <div class="site-wrap footer-main">
    <div>
      <p class="eyebrow">Passerine / Business Analysis</p>
      <h2>Get in<br />touch.</h2>
      <a class="button button-light" href={`mailto:${portfolio.email}`}>Email me <span aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-side">
      <p><span class="person-name">{portfolio.name}</span><br />{portfolio.location}, Vietnam</p>
      <nav aria-label="Footer navigation">
        {footerNavigation.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </div>
  <div class="site-wrap footer-bottom">
    <span>© {new Date().getFullYear()} {portfolio.alias}</span>
    <div><a href={portfolio.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href="#top">Back to top ↑</a></div>
  </div>
</footer>
