---
import { internNavigation } from '../data/navigation';
import { portfolio } from '../data/portfolio';
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3 sm:px-6">
    <a
      class="shrink-0 font-oswald text-xl font-bold uppercase tracking-wide text-ink"
      href="/intern/"
    >
      {portfolio.alias}
      <span class="text-primary">.</span>
    </a>
    <nav
      class="min-w-0 flex-1 overflow-x-auto"
      aria-label="The Intern sections"
    >
      <ul class="flex w-max items-center gap-5 text-xs font-semibold uppercase tracking-wide text-ink sm:gap-6">
        {internNavigation.map(({ label, href }) => (
          <li>
            <a class="transition-colors hover:text-link-hover" href={href}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
