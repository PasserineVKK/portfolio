---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';
interface Props { title: string; number: string; description: string; }
const { title, number, description } = Astro.props;
---

<Layout title={`${title} | Passerine`} description={description}>
  <div id="top"></div>
  <header class="site-header"><div class="site-wrap header-inner persona-header"><a class="brand" href="/"><Image src={logo} alt="" width={34} height={34} />Passerine<span aria-hidden="true">.</span></a><a class="header-contact" href="/intern/">The Intern ↗</a></div></header>
  <main id="main" class="persona-main" aria-labelledby="persona-title">
    <div class="site-wrap persona-content">
      <p class="eyebrow">{number} / 04 — Passerine</p>
      <h1 id="persona-title">{title}</h1>
      <div class="persona-bottom"><p>There is more to me than my work. This part of the story is still taking shape.</p><a class="button" href="/intern/">See my work <span aria-hidden="true">↗</span></a></div>
    </div>
  </main>
  <Footer />
</Layout>
