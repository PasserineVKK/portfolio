---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

{eyebrow && (
  <p class="mb-3 text-sm font-bold uppercase tracking-[.2em] text-link-text">
    {eyebrow}
  </p>
)}
<h2
  id={id}
  class="font-oswald text-5xl font-bold uppercase leading-none sm:text-7xl"
>
  {title}
</h2>
